; Engine configuration file (Godot 3.5.x) - DarkX TECH Edition
config_version=4

[application]

config/name="DarkX Death Race"
config/description="Death Race - DarkX TECH Edition"
run/main_scene="res://src/LoadingScene.tscn"
boot_splash/image="res://branding/dx_logo.png"
boot_splash/fullsize=true
boot_splash/bg_color=Color( 0.03, 0.03, 0.04, 1 )
config/icon="res://branding/icon.png"
config/version="1.0.0"

[autoload]

Main="*res://src/Main.gd"

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1280
window/size/test_height=720
window/vsync/use_vsync=true
window/stretch/mode="2d"
window/stretch/aspect="keep"

